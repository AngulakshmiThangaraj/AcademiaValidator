# Environment Variables Template
# Copy this file to .env and set your production values

# Application Settings
ENV=production
PORT=8000
SECRET_KEY=your_super_secret_production_key_here

# Database Configuration (PostgreSQL / MySQL / SQLite)
DATABASE_URL=sqlite:///./backend/sih_certificates.db
DATABASE_PATH=

# API & CORS Settings
ALLOWED_ORIGINS=https://authenticity-validator-academia.vercel.app,http://localhost:8000
BACKEND_URL=http://localhost:8000

# ML Model Storage (Optional Cloud Bucket URL if model > 100MB)
MODEL_URL=
